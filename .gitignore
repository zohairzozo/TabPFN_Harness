# Secrets
.env

# Data and caches
results/cache/*
# The recorded LLM responses are small and are needed to replay the demo with no network.
!results/cache/llm/
data/raw/

# Model weights
*.pt
*.ckpt
weights/
models/
checkpoints/
tabpfn_weights/

# Python
__pycache__/
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/

# The fast profile writes its own PFN cache. It is a cache, like results/cache/.
results/fast/cache/

# Kept on disk, never committed.
interview.docx

# The demo writes its run output to results/cache/demo now; this folder is old output.
results/demo/
